<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="zjc.knowledgemanager.mapper.DocumentTagMapper">

    <resultMap id="BaseResultMap" type="zjc.knowledgemanager.entity.DocumentTag">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="document_id" property="documentId" jdbcType="BIGINT"/>
        <result column="tag_id" property="tagId" jdbcType="BIGINT"/>
        <result column="creator_id" property="creatorId" jdbcType="BIGINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, document_id, tag_id, creator_id, create_time
    </sql>

    <select id="findByDocumentIdAndTagId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM document_tag
        WHERE document_id = #{documentId} AND tag_id = #{tagId}
    </select>

    <select id="findByDocumentId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM document_tag
        WHERE document_id = #{documentId}
        ORDER BY create_time DESC
    </select>

    <select id="findByTagId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM document_tag
        WHERE tag_id = #{tagId}
        ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="zjc.knowledgemanager.entity.DocumentTag">
        INSERT INTO document_tag (
            id, document_id, tag_id, creator_id
        ) VALUES (
            #{id}, #{documentId}, #{tagId}, #{creatorId}
        )
    </insert>

    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO document_tag (id, document_id, tag_id, creator_id)
        VALUES
        <foreach collection="documentTags" item="item" separator=",">
            (#{item.id}, #{item.documentId}, #{item.tagId}, #{item.creatorId})
        </foreach>
    </insert>

    <delete id="deleteByDocumentIdAndTagId">
        DELETE FROM document_tag 
        WHERE document_id = #{documentId} AND tag_id = #{tagId}
    </delete>

    <delete id="deleteByDocumentId">
        DELETE FROM document_tag WHERE document_id = #{documentId}
    </delete>

    <delete id="deleteByTagId">
        DELETE FROM document_tag WHERE tag_id = #{tagId}
    </delete>

</mapper>